# HydroPulse AI Environment Variables Example
# Copy to .env and adjust as necessary

# Application Configuration
FLASK_APP=src.hydropulse.api.factory:create_app
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-this-in-production-use-a-strong-secret-key
PORT=5000
HOST=0.0.0.0

# Database
DATABASE_URL=sqlite:///data/interim/hydropulse.db

# Ingestion / API Settings
OPENMETEO_TIMEOUT_SECONDS=15
REQUESTS_CACHE_EXPIRE_AFTER=21600 # 6 hours in seconds

# Logging
LOG_LEVEL=INFO
