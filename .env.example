# ==============================================================================
# HydroPulse AI — Environment Variables & Production Hardening Specification
# ==============================================================================
# Copy this template to .env for local overrides, or set via container runtime / cloud secrets.
# NEVER commit credentials, private keys, or .env files to source control.

# ------------------------------------------------------------------------------
# 1. Flask & Application Core
# ------------------------------------------------------------------------------
FLASK_APP=src.hydropulse.api.factory:create_app
FLASK_ENV=production
FLASK_DEBUG=0
PORT=5000
HOST=0.0.0.0

# Critical: Generate a high-entropy secret key in production (e.g. `openssl rand -hex 32`)
SECRET_KEY=change-this-in-production-use-a-strong-secret-key

# ------------------------------------------------------------------------------
# 2. Database & Persistent Storage
# ------------------------------------------------------------------------------
# SQLite default; production environments can specify PostgreSQL URLs:
# e.g. postgresql://hydropulse_user:strongpassword@db.internal:5432/hydropulse_db
DATABASE_URL=sqlite:///data/interim/hydropulse.db

# ------------------------------------------------------------------------------
# 3. Security, Networking & CORS
# ------------------------------------------------------------------------------
# Comma-separated list of allowed origins for cross-origin API requests, or '*' for public access
CORS_ORIGINS=*

# Client rate limiting (sliding window threshold per IP address per minute)
RATE_LIMIT_PER_MINUTE=60

# In-memory REST API response caching time-to-live in seconds
CACHE_TTL_SECONDS=300

# ------------------------------------------------------------------------------
# 4. Ingestion, Open-Meteo & Upstream APIs
# ------------------------------------------------------------------------------
# Upstream HTTP request timeout in seconds
OPENMETEO_TIMEOUT_SECONDS=15

# Upstream requests-cache duration in seconds (6 hours default)
REQUESTS_CACHE_EXPIRE_AFTER=21600

# ------------------------------------------------------------------------------
# 5. Logging & Observability
# ------------------------------------------------------------------------------
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# 6. Map & Geospatial Tiles
# ------------------------------------------------------------------------------
# Optional Mapbox public token for satellite & terrain tiles (leave empty to use free CartoDB/OSM tiles)
MAPBOX_ACCESS_TOKEN=
